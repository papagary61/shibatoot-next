# Prisma database (SQLite in dev)
DATABASE_URL="file:./dev.db"

# Blockchain RPC connection (Base mainnet)
BASE_RPC_URL="https://base-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE"

# Treasury wallet address
TREASURY_ADDRESS="0xYourTreasuryWalletHere"

# Comma-separated list of admin wallets
ADMIN_WALLETS="0xAdmin1,0xAdmin2"

# Launchpad settings
NEXT_PUBLIC_LP_USD="1500000"                # Total LP amount in USD
NEXT_PUBLIC_LP_GROWTH_PCT="6.2"             # Growth percent for LP
NEXT_PUBLIC_BONUS_THRESHOLD_USD="1200000"   # Bonus trigger threshold
NEXT_PUBLIC_BONUS_GROWTH_TRIGGER_PCT="5"    # Growth trigger percent
